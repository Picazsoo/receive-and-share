CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_TLS=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_INTERNAL_LIBTOMMATH_FAST=y
CONFIG_NO_RADIUS=y
CONFIG_NO_ACCOUNTING=y
CONFIG_NO_VLAN=y
CONFIG_CTRL_IFACE=y
CC=$(HOTSPOT_CC)
CFLAGS += -I../../sysroot/include/libnl3
LIBS += -L../../sysroot/lib
LDFLAGS += -static